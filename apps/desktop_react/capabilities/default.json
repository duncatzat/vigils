{
  "$schema": "https://schema.tauri.app/config/2/capability",
  "identifier": "default",
  "description": "I08b-β1 capability 白名单 —— 系统能力(core:default)+ 应用层 30 条 invoke command 显式 allow。新增/删除 handler 必须三处同步:commands.rs + main.rs 的 generate_handler! + capabilities/default.json。",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-list-sessions",
    "allow-list-pending-approvals",
    "allow-get-approval-detail",
    "allow-resolve-approval",
    "allow-list-recent-events",
    "allow-get-event-detail",
    "allow-fts-search",
    "allow-anchor-checkpoint",
    "allow-update-hub-config",
    "allow-list-onnx-models",
    "allow-ensure-onnx-model",
    "allow-register-server",
    "allow-list-servers",
    "allow-get-server-onboarding",
    "allow-list-pending-tool-approvals",
    "allow-list-drifted-tools",
    "allow-list-drifted-servers",
    "allow-approve-tool",
    "allow-approve-tool-drift",
    "allow-reject-tool-drift",
    "allow-approve-server-command-drift",
    "allow-reject-server-command-drift",
    "allow-list-sandbox-profiles",
    "allow-get-sandbox-profile",
    "allow-upsert-sandbox-profile",
    "allow-replay-session",
    "allow-verify-chain",
    "allow-list-privacy-findings",
    "allow-export-session-replay",
    "allow-protection-summary"
  ]
}
